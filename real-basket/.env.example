# LLM provider (only needed for the chat agent and embedding search)
# Option A - OpenAI (api.openai.com)
OPENAI_API_KEY=sk-...
OPENAI_MODEL_ID=gpt-4o-mini

# Option B - Azure OpenAI (set OPENAI_API_TYPE=azure; model names are deployment names)
#OPENAI_API_TYPE=azure
#OPENAI_API_VERSION=2024-02-15-preview
#AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
#AZURE_OPENAI_API_KEY=
#AZURE_COMPLETION_MODEL=gpt-4o
#AZURE_EMBEDDING_MODEL=text-embedding-3-large

# Agent
AGENT_NAME=REALBASKET-ORCHESTRATOR

# Data: real data only, parsed from the reference PDFs in KNOWLEDGE_DIR (no demo data, no fallback)

# Reserved for a live VPI collector (not used yet)
DESTATIS_GENESIS_TOKEN=

# Local cache (method-note index)
DATA_DIR=data_store

# Reference PDFs: source of the real data (tables) and of the method notes (RAG; context only)
KNOWLEDGE_DIR=reports/real-data
# bm25 | embedding | auto (embedding if an LLM provider is configured)
KNOWLEDGE_RETRIEVER=auto
EMBEDDING_MODEL_ID=text-embedding-3-small
KNOWLEDGE_TOP_K=4

# MCP + hybrid PDF storage (optional)
MCP_HOST=127.0.0.1
MCP_PORT=8001
REALBASKET_SQLITE_PATH=data_store/realbasket.sqlite3
WEAVIATE_HOST=localhost
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051
WEAVIATE_INDEX_NAME=RealBasketDocuments
# OPENAI_API_KEY must be configured to create and query embeddings.

# Docker Compose: set true after configuring OpenAI/Azure embedding credentials
REALBASKET_AUTO_INDEX_VECTOR=false
# Client URL for running Streamlit outside Docker (Compose overrides internally)
REALBASKET_MCP_URL=http://127.0.0.1:8001/mcp
